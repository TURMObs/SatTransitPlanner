__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Packaging build artifacts (from pip wheel / build / pip install -e).
build/
dist/
*.egg-info/
*.egg

# Local machine state, not shared: it records absolute paths from this checkout.
.claude/settings.local.json

# Local site configuration and results. The glob also covers backups such as
# config.old.json, which a rule naming config.json alone would let through.
config*.json
!config.example.json
transits.json

# Downloaded orbital elements (OMM JSON), size catalogue and ephemerides.
# Space-Track's user agreement restricts passing its data on, so this must not
# be committed.
cache/
*.bsp
